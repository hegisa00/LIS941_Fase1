APP_NAME="La Cuponera SV"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/El_Salvador

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Base de datos (XAMPP: usuario root sin contraseña por defecto)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cuponera_sv
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Los correos se escriben en storage/logs/laravel.log (no hace falta servidor de correo)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@cuponera.sv"
MAIL_FROM_NAME="${APP_NAME}"
